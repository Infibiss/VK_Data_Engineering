{"files": [{"id": 33822641, "name": "it_vacancy_data.csv", "size": 87555558, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/33822641", "supplied_md5": "5e6a8c26ed481e327f5509de10358b11", "computed_md5": "5e6a8c26ed481e327f5509de10358b11", "mimetype": "text/plain"}], "folder_structure": {}, "authors": [{"id": 11746229, "full_name": "Andrei Ternikov", "first_name": "Andrei", "last_name": "Ternikov", "is_active": true, "url_name": "Andrei_Ternikov", "orcid_id": "0000-0003-2354-0109"}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/it_vacancy_data/19005092", "download_disabled": false, "description": "The dataset represents job advertisements obtained from HeadHunter online hiring platform (collected with open API https://dev.hh.ru/) for specialists in Information Technologies (in accordance with classifier https://github.com/hhru/api/blob/master/docs_eng/specializations.md). Description of main fields for vacancies is available via link https://github.com/hhru/api/blob/master/docs_eng/vacancies.md.<div><br></div><div>Fields:</div><div><br></div><div>1. <i>vacid</i> - id of vacancy in processed dataset (int);</div><div>2. <i>id</i> - vacancy ID corresponding to HeadHunter platform (int);</div><div>3. <i>name</i> - job position name (string)</div><div>4. <i>specializations.id</i> - the list of professional specializations of the vacancy according to HeadHunter classifier (string, separated with pipe(s));</div><div>5. <i>area.id </i>- the region (city) of the vacancy according to HeadHunter classifier (int);</div><div>6. <i>published_at </i>- the data of vacancy publishing (date in YYYY-MM-DD format);</div><div>7. <i>key_skills</i> - the list of skills introduced in the vacancy (string, separated with pipe(s)).</div><div><br></div>", "funding": null, "funding_list": [], "version": 1, "status": "public", "size": 87555558, "created_date": "2022-01-24T14:26:51Z", "modified_date": "2022-01-24T14:27:10Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["it job ads", "vacancies", "Human Resources Management", "Applied Computer Science"], "keywords": ["it job ads", "vacancies", "Human Resources Management", "Applied Computer Science"], "categories": [{"id": 25405, "title": "Human resources management", "parent_id": 25396, "path": "/25282/25396/25405", "source_id": "350503", "taxonomy_id": 100}, {"id": 28822, "title": "Applied computing not elsewhere classified", "parent_id": 28801, "path": "/28798/28801/28822", "source_id": "460199", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Ternikov, Andrei (2022). it_vacancy_data. figshare. Dataset. https://doi.org/10.6084/m9.figshare.19005092.v1", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": "file", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 19005092, "title": "it_vacancy_data", "doi": "10.6084/m9.figshare.19005092.v1", "handle": "", "url": "https://api.figshare.com/v2/articles/19005092", "published_date": "2022-01-24T14:26:51Z", "thumb": "", "defined_type": 3, "defined_type_name": "dataset", "group_id": null, "url_private_api": "https://api.figshare.com/v2/account/articles/19005092", "url_public_api": "https://api.figshare.com/v2/articles/19005092", "url_private_html": "https://figshare.com/account/articles/19005092", "url_public_html": "https://figshare.com/articles/dataset/it_vacancy_data/19005092", "timeline": {"posted": "2022-01-24T14:26:51", "firstOnline": "2022-01-24"}, "resource_title": null, "resource_doi": null}